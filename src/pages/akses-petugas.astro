---
import Base from '../layouts/Base.astro';
import Kepala from '../components/Kepala.astro';
import { situs } from '../config/situs';
---

<Base judul="Akses petugas" deskripsi="Cara memperoleh akun petugas atau manajemen HyTrack lewat pengelola.">
  <Kepala
    judul="Belum punya akses petugas?"
    eyebrow="Akses petugas"
    jejak={[{ label: 'Akses petugas' }]}
    lead="Akun petugas, dokter, farmasi, laboratorium, dan manajemen tidak bisa dibuat sendiri. Semuanya dibuat oleh pengelola HyTrack di fasilitasmu."
  />

  <section class="section-tight">
    <div class="narrow prose">
      <h2>Cara memperoleh akses</h2>
      <ol class="steps">
        <li>Hubungi pengelola atau administrator HyTrack di unit kerjamu (misalnya kepala instalasi rawat jalan atau tim IT).</li>
        <li>Sebutkan nama, unit kerja, dan peranmu: petugas meja poli, dokter, laboratorium/penunjang, farmasi, atau manajemen.</li>
        <li>Pengelola membuat akun dan memberikan ID pengguna. Kata sandi awal diberikan langsung oleh pengelola, bukan lewat situs ini.</li>
        <li>Masuk di halaman <strong>Masuk Petugas</strong>, pilih peran <strong>Petugas</strong> atau <strong>Manajemen</strong> sesuai akunmu.</li>
      </ol>

      <h2>Hal yang perlu diketahui</h2>
      <ul>
        <li>Akun pasien tidak bisa dipakai di halaman Masuk Petugas, dan akun petugas tidak bisa dipakai di halaman masuk pasien.</li>
        <li>Belum ada reset kata sandi mandiri. Bila lupa kata sandi, hubungi pengelola untuk diatur ulang.</li>
        <li>Jangan pernah membagikan kata sandi, termasuk kepada rekan kerja atau lewat chat.</li>
      </ul>

      <p class="catatan">
        Fasilitas kesehatanmu belum memakai HyTrack? Lihat <a href="/kerja-sama">Kerja Sama Fasilitas Kesehatan</a>.
      </p>

      <div class="cta-pair">
        <a class="btn btn-primary" href={situs.aplikasi.masukPetugas}>Masuk Petugas →</a>
        <a class="btn btn-secondary" href="/bantuan">Kontak & Bantuan</a>
      </div>
    </div>
  </section>
</Base>
