---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Ikon from '../components/Ikon.astro';
import { situs } from '../config/situs';
import { footer, menuUtama } from '../data/navigasi';

interface Props {
  judul: string;
  deskripsi?: string;
}
const { judul, deskripsi = 'HyTrack, Teman Perjalanan Berobat: ambil nomor antrean, tahu kapan berangkat, dan ikuti kunjunganmu dari HP.' } =
  Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const judulPenuh = path === '/' ? `${situs.nama} — ${situs.slogan}` : `${judul} · ${situs.nama}`;
const kanonik = new URL(path, Astro.site).href;
const aktif = (href: string) => path === href || path.startsWith(href + '/');
const sosial = Object.entries(situs.sosial).filter(([, url]) => url);
const tahun = new Date().getFullYear();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{judulPenuh}</title>
    <meta name="description" content={deskripsi} />
    <link rel="canonical" href={kanonik} />
    <link rel="icon" type="image/png" href="/assets/favicon.png" />
    <meta name="theme-color" content="#0b3b37" />
    <meta property="og:title" content={judulPenuh} />
    <meta property="og:description" content={deskripsi} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={kanonik} />
    <meta property="og:image" content={new URL('/assets/og-hytrack.png', Astro.site).href} />
    <link rel="preload" as="image" href="/brand/logo-hytrack.webp" type="image/webp" />
    <script is:inline>
      // Deteksi perangkat untuk mengurutkan tombol unduh. ?perangkat=android|ios|desktop untuk uji.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var q = new URLSearchParams(location.search).get('perangkat');
        var ua = navigator.userAgent || '';
        var ios = /iPhone|iPad|iPod/i.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        var p = q && /^(android|ios|desktop)$/.test(q) ? q : /Android/i.test(ua) ? 'android' : ios ? 'ios' : 'desktop';
        d.setAttribute('data-perangkat', p);
        // Tirai pergantian halaman: bila halaman sebelumnya menutup tirai, buka tirai di sini.
        try {
          if (sessionStorage.getItem('hytrack-tirai') === '1') {
            sessionStorage.removeItem('hytrack-tirai');
            if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('tirai-masuk');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#isi">Lompat ke isi</a>
    <div class="kemajuan" aria-hidden="true"></div>
    <div class="tirai" aria-hidden="true">
      <picture>
        <source srcset="/brand/logo-hytrack.webp" type="image/webp" />
        <img src="/brand/logo-hytrack.png" alt="" width="72" height="52" />
      </picture>
    </div>

    <header class="site-header">
      <div class="nav-pill on-dark">
        <div class="nav-bar">
          <a class="brand" href="/" aria-label="HyTrack, ke beranda">
            <picture>
              <source srcset="/brand/logo-hytrack.webp" type="image/webp" />
              <img src="/brand/logo-hytrack.png" alt="" width="52" height="38" />
            </picture>
            <span class="brand-text">
              <span class="brand-name">HyTrack</span>
              <span class="brand-tag">{situs.slogan}</span>
            </span>
          </a>

          <nav aria-label="Menu utama">
            <ul class="nav-links">
              {
                menuUtama.map((m) => (
                  <li>
                    <a href={m.href} aria-current={aktif(m.href) ? 'page' : undefined}>
                      {m.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>

          <div class="nav-aksi">
            <a class="btn btn-white nav-web" href={situs.aplikasi.web} data-magnet>
              Buka HyTrack Web <Ikon nama="luar" ukuran={16} />
            </a>
            <button class="menu-btn" type="button" aria-expanded="false" aria-controls="menu-hp" aria-label="Buka menu">
              <Ikon nama="menu" ukuran={20} class="ikon-buka" />
              <Ikon nama="tutup" ukuran={20} class="ikon-tutup" />
            </button>
          </div>
        </div>

        <div class="menu-hp" id="menu-hp">
          <div>
            <nav aria-label="Menu utama (HP)">
              <ul>
                {
                  menuUtama.map((m) => (
                    <li>
                      <a href={m.href} aria-current={aktif(m.href) ? 'page' : undefined} tabindex="-1">
                        {m.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
              <a class="btn btn-white" href={situs.aplikasi.web} tabindex="-1">Buka HyTrack Web <Ikon nama="luar" ukuran={16} /></a>
            </nav>
          </div>
        </div>
      </div>
    </header>

    <main id="isi" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer on-dark">
      <div class="rings footer-rings" aria-hidden="true"></div>
      <div class="wrap footer-inner">
        <div class="footer-brand" data-reveal>
          <a class="brand" href="/" aria-label="HyTrack, ke beranda">
            <picture>
              <source srcset="/brand/logo-hytrack.webp" type="image/webp" />
              <img src="/brand/logo-hytrack.png" alt="" width="52" height="38" loading="lazy" />
            </picture>
            <span class="brand-text">
              <span class="brand-name">HyTrack</span>
              <span class="brand-tag">{situs.slogan}</span>
            </span>
          </a>
          <p>Aplikasi antrean rawat jalan untuk pasien dan petugas rumah sakit.</p>
        </div>

        <div class="footer-cols">
          {
            footer.map((kolom, i) => (
              <section class="footer-col" aria-labelledby={`fk-${i}`} data-reveal>
                <h2 id={`fk-${i}`}>
                  <button class="footer-toggle" type="button" aria-expanded="true" aria-controls={`fl-${i}`}>
                    <span>{kolom.judul}</span>
                    <svg class="chev" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </button>
                </h2>
                <ul id={`fl-${i}`}>
                  {kolom.tautan.map((t) => (
                    <li>
                      <a href={t.href}>{t.label}</a>
                    </li>
                  ))}
                </ul>
                {i === footer.length - 1 && !situs.kontak.email && !situs.kontak.whatsapp && (
                  <p class="footer-kontak">Kontak resmi segera diumumkan</p>
                )}
              </section>
            ))
          }
        </div>

        <p class="footer-wordmark" aria-hidden="true" data-wordmark>HyTrack</p>

        <div class="footer-bottom">
          <span>© {tahun} HyTrack</span>
          <nav aria-label="Dokumen">
            <a href="/ketentuan">Ketentuan</a>
            <a href="/privasi">Privasi</a>
          </nav>
          {
            sosial.length > 0 && (
              <ul class="footer-social" aria-label="Media sosial">
                {sosial.map(([nama, url]) => (
                  <li>
                    <a href={url} rel="noopener">
                      {nama}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/gerak';

      // Menu HP
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
      const menu = document.getElementById('menu-hp');
      const tautanMenu = [...(menu?.querySelectorAll<HTMLAnchorElement>('a') ?? [])];
      const setMenu = (buka: boolean) => {
        btn?.setAttribute('aria-expanded', String(buka));
        btn?.setAttribute('aria-label', buka ? 'Tutup menu' : 'Buka menu');
        menu?.classList.toggle('buka', buka);
        tautanMenu.forEach((a) => (buka ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
      };
      btn?.addEventListener('click', () => setMenu(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menu?.classList.contains('buka')) {
          setMenu(false);
          btn?.focus();
        }
      });

      // Footer: akordeon di HP (< 768px), selalu terbuka di layar lebar.
      const mq = window.matchMedia('(max-width: 767px)');
      const toggles = [...document.querySelectorAll<HTMLButtonElement>('.footer-toggle')];
      const atur = (buka: boolean, t: HTMLButtonElement) => {
        t.setAttribute('aria-expanded', String(buka));
        const list = document.getElementById(t.getAttribute('aria-controls') || '');
        if (list) list.hidden = !buka;
      };
      const sesuaikan = () => {
        toggles.forEach((t) => {
          if (mq.matches) {
            atur(false, t);
            t.removeAttribute('tabindex');
          } else {
            atur(true, t);
            t.removeAttribute('aria-expanded');
            t.setAttribute('tabindex', '-1');
          }
        });
      };
      toggles.forEach((t) =>
        t.addEventListener('click', () => {
          if (!mq.matches) return;
          atur(t.getAttribute('aria-expanded') !== 'true', t);
        }),
      );
      mq.addEventListener('change', sesuaikan);
      sesuaikan();
    </script>
  </body>
</html>
