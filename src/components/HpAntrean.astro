---
/**
 * Layar "Pantau antrean" di bingkai HP, disalin dari mockup Emergent (LiveQueuePhone).
 * Angka adalah data contoh, tidak terhubung ke sistem rumah sakit.
 * Nomor yang dilayani berganti setiap 4 detik; berhenti saat kursor/fokus berada di HP,
 * saat HP tidak terlihat, atau bila pengguna memilih "kurangi gerakan".
 */
const SERVING = ['A-024', 'A-025', 'A-026'];
const WAITS = ['15–25', '10–15', '5–10'];
---

<div class="lq" data-lq data-serving={JSON.stringify(SERVING)} data-waits={JSON.stringify(WAITS)}>
  <div class="lq-frame" role="group" aria-label="Contoh layar pantau antrean HyTrack dengan data contoh">
    <div class="lq-screen">
      <div class="lq-notch" aria-hidden="true"></div>
      <div class="lq-body">
        <p class="lq-note">Data contoh · Tidak terhubung ke sistem rumah sakit</p>
        <p class="lq-title">Pantau antrean</p>
        <p class="lq-clinic">Penyakit Dalam · dr. Rina Kusuma, Sp.PD</p>
        <div class="lq-status">
          <span class="lq-live"><span class="lq-ping" aria-hidden="true"><span></span><span></span></span>Terhubung</span>
          <span>Diperbarui 08.42</span>
        </div>

        <div class="lq-card">
          <p class="lq-label">NOMOR ANTREAN ANDA</p>
          <p class="lq-num">A-027</p>
          <div class="lq-serving">
            <span class="sr-only" aria-live="polite" aria-atomic="true" data-lq-announce>Sedang dilayani A-024. 3 pasien di depan Anda.</span>
            <div aria-hidden="true" class="lq-serving-row">
              <span>Sedang dilayani</span>
              <span class="lq-roll"><span data-lq-serving>A-024</span></span>
            </div>
          </div>
          <div class="lq-stats" aria-hidden="true">
            <div><p class="lq-big" data-lq-ahead>3</p><p class="lq-small">di depan Anda</p></div>
            <div><p class="lq-big"><span data-lq-wait>15–25</span><span class="lq-unit"> mnt</span></p><p class="lq-small">Perkiraan tunggu</p></div>
          </div>
          <div class="lq-bar" aria-hidden="true"><span data-lq-bar style="width:25%"></span></div>
        </div>

        <div class="lq-actions" aria-hidden="true">
          <div class="lq-act primary">Tampilkan QR check-in</div>
          <div class="lq-act-row">
            <div class="lq-act">Bagikan ke pendamping</div>
            <div class="lq-act">Tanya Hya</div>
          </div>
        </div>
      </div>
      <div class="lq-tabs" aria-hidden="true">
        <span><i></i>Beranda</span>
        <span class="on"><i></i>Kunjungan</span>
        <span><i></i>Akun</span>
      </div>
    </div>
  </div>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-lq]').forEach((hp) => {
    const serving: string[] = JSON.parse(hp.dataset.serving || '[]');
    const waits: string[] = JSON.parse(hp.dataset.waits || '[]');
    const elServing = hp.querySelector<HTMLElement>('[data-lq-serving]')!;
    const elAhead = hp.querySelector<HTMLElement>('[data-lq-ahead]')!;
    const elWait = hp.querySelector<HTMLElement>('[data-lq-wait]')!;
    const elBar = hp.querySelector<HTMLElement>('[data-lq-bar]')!;
    const elAnnounce = hp.querySelector<HTMLElement>('[data-lq-announce]')!;
    let idx = 0;
    let tahan = false;
    let terlihat = true;
    const tampilkan = () => {
      const ahead = 3 - idx;
      elServing.classList.remove('masuk');
      void elServing.offsetWidth;
      elServing.textContent = serving[idx];
      elServing.classList.add('masuk');
      elAhead.textContent = String(ahead);
      elWait.textContent = waits[idx];
      elBar.style.width = `${((idx + 1) / 4) * 100}%`;
      elAnnounce.textContent = `Sedang dilayani ${serving[idx]}. ${ahead} pasien di depan Anda.`;
    };
    if (reduce) return;
    hp.addEventListener('pointerenter', () => (tahan = true));
    hp.addEventListener('pointerleave', () => (tahan = false));
    hp.addEventListener('focusin', () => (tahan = true));
    hp.addEventListener('focusout', () => (tahan = false));
    new IntersectionObserver(([e]) => (terlihat = e.isIntersecting)).observe(hp);
    window.setInterval(() => {
      if (tahan || !terlihat || document.hidden) return;
      idx = (idx + 1) % serving.length;
      tampilkan();
    }, 4000);
  });
</script>

<style>
  .lq {
    display: flex;
    justify-content: center;
  }
  .lq-frame {
    width: 272px;
    border-radius: 46px;
    background: #0d1714;
    padding: 9px;
    box-shadow:
      0 40px 80px -30px rgba(11, 59, 55, 0.55),
      inset 0 0 0 1.5px rgba(255, 255, 255, 0.08);
  }
  @media (min-width: 640px) {
    .lq-frame {
      width: 300px;
    }
  }
  .lq-screen {
    position: relative;
    height: 560px;
    overflow: hidden;
    border-radius: 38px;
    background: linear-gradient(to bottom, #eaf4ef, var(--screen), var(--cream));
    color: var(--pine);
  }
  @media (min-width: 640px) {
    .lq-screen {
      height: 610px;
    }
  }
  .lq-notch {
    position: absolute;
    left: 50%;
    top: 10px;
    z-index: 2;
    width: 86px;
    height: 22px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #0d1714;
  }
  .lq-body {
    padding: 44px 16px 96px;
  }
  .lq-body p {
    margin: 0;
  }
  .lq-note {
    font-size: 12px;
    color: var(--ink-soft);
  }
  .lq-title {
    margin-top: 12px !important;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .lq-clinic {
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .lq-status {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 12px;
    font-size: 12px;
    color: var(--ink-soft);
  }
  .lq-live {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
    color: var(--teal);
  }
  .lq-ping {
    position: relative;
    display: flex;
    width: 8px;
    height: 8px;
  }
  .lq-ping span {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--teal);
  }
  .lq-ping span:first-child {
    background: rgba(8, 111, 101, 0.6);
    animation: ping 1s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  .lq-card {
    margin-top: 12px;
    border-radius: 24px;
    background: #fff;
    padding: 16px;
    box-shadow: var(--shadow);
  }
  .lq-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }
  .lq-num {
    margin-top: 4px !important;
    font-size: 52px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .lq-serving {
    margin-top: 16px;
    border-radius: 16px;
    background: var(--mint);
    padding: 10px 12px;
  }
  .lq-serving-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12px;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .lq-roll {
    position: relative;
    height: 24px;
    width: 64px;
    overflow: hidden;
    text-align: right;
  }
  .lq-roll span {
    display: block;
    font-size: 18px;
    font-weight: 700;
    color: var(--teal);
  }
  .lq-roll span.masuk {
    animation: lq-masuk 0.5s var(--ease);
  }
  @keyframes lq-masuk {
    from {
      transform: translateY(22px);
      opacity: 0;
    }
  }
  .lq-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 12px;
  }
  .lq-stats > div {
    border: 1px solid rgba(11, 59, 55, 0.1);
    border-radius: 16px;
    padding: 8px 12px;
  }
  .lq-big {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
  }
  .lq-unit {
    font-size: 12px;
    font-weight: 600;
  }
  .lq-small {
    font-size: 12px;
    line-height: 1.25;
    color: var(--ink-soft);
  }
  .lq-bar {
    margin-top: 12px;
    height: 8px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--mint);
  }
  .lq-bar span {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: var(--teal);
    transition: width 0.8s var(--ease);
  }
  .lq-actions {
    display: grid;
    gap: 8px;
    margin-top: 12px;
  }
  .lq-act {
    border: 1px solid rgba(8, 111, 101, 0.3);
    border-radius: 999px;
    background: #fff;
    padding: 8px 0;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: var(--teal);
  }
  .lq-act.primary {
    border: 0;
    background: var(--teal);
    padding: 10px 0;
    font-size: 13px;
    color: #fff;
  }
  .lq-act-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .lq-tabs {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid rgba(11, 59, 55, 0.05);
    border-radius: 26px 26px 0 0;
    background: rgba(255, 255, 255, 0.95);
    padding: 8px 8px 12px;
  }
  .lq-tabs span {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .lq-tabs i {
    display: grid;
    place-items: center;
    width: 48px;
    height: 24px;
    border-radius: 999px;
  }
  .lq-tabs i::after {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 4px;
    border: 2px solid rgba(58, 86, 82, 0.7);
  }
  .lq-tabs .on {
    color: var(--teal);
  }
  .lq-tabs .on i {
    background: var(--mint);
  }
  .lq-tabs .on i::after {
    border-color: var(--teal);
  }
</style>
