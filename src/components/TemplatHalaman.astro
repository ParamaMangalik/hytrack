---
import Base from '../layouts/Base.astro';
import Status from './Status.astro';
import Visual from './Visual.astro';
import Ikon from './Ikon.astro';
import { cariHalaman, urlHalaman, type Halaman } from '../data/halaman';

interface Props {
  h: Halaman;
}
const { h } = Astro.props;
const induk = h.kelompok === 'fitur' ? { label: 'Fitur', href: '/fitur' } : { label: 'Untuk Siapa', href: '/untuk' };
const terkait = h.terkait.map(cariHalaman).filter((x): x is Halaman => Boolean(x));
---

<Base judul={h.label} deskripsi={`${h.pertanyaan} ${h.ringkas}`}>
  <section class="page-hero">
    <div class="wrap">
      <p class="crumbs"><a href="/">Beranda</a> / <a href={induk.href}>{induk.label}</a> / {h.label}</p>
      <span class="eyebrow">{h.label}</span>
      <h1>{h.pertanyaan}</h1>
      <p class="lead">{h.ringkas}</p>
      <div class="status-row">
        <Status status={h.status} />
        {h.statusCatatan && <span class="status-note">{h.statusCatatan}</span>}
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap th-grid">
      <div>
        <h2 class="h-sub">{h.alur.judul}</h2>
        <ol class="steps">
          {h.alur.langkah.map((l) => <li>{l}</li>)}
        </ol>

        <h2 class="h-sub mt">Yang perlu diketahui</h2>
        <ul class="facts">
          {
            h.perluDiketahui.map((f) => (
              <li>
                <Ikon nama="info" ukuran={20} />
                <span>{f}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="th-visual">
        <Visual visual={h.visual} />
      </div>
    </div>
  </section>

  <section class="section-tight bg-cream">
    <div class="wrap">
      <a class="next card" href={h.lanjut.href}>
        <span class="eyebrow">Langkah berikutnya</span>
        <span class="next-title">
          {h.lanjut.label}
          {h.lanjut.eksternal ? <Ikon nama="luar" ukuran={22} /> : <Ikon nama="kanan" ukuran={22} />}
        </span>
        <span class="next-text">{h.lanjut.teks}</span>
      </a>

      <h2 class="h-sub mt">Halaman terkait</h2>
      <ul class="related">
        {
          terkait.map((t) => (
            <li>
              <a href={urlHalaman(t)}>
                <strong>{t.label}</strong>
                <span>{t.pertanyaan}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .status-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    margin-top: 1.5rem;
  }
  .status-note {
    font-size: 0.93rem;
    color: var(--muted);
    max-width: 70ch;
  }
  .th-grid {
    display: grid;
    gap: 3rem;
  }
  @media (min-width: 960px) {
    .th-grid {
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
    }
    .th-visual {
      position: sticky;
      top: 100px;
    }
  }
  .h-sub {
    font-size: 1.35rem;
    margin-bottom: 1.25rem;
  }
  .mt {
    margin-top: 2.75rem;
  }
  .facts {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.8rem;
  }
  .facts li {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
  }
  .facts :global(svg) {
    color: var(--teal-700);
    flex: none;
    margin-top: 2px;
  }
  .next {
    display: grid;
    gap: 0.3rem;
    text-decoration: none;
    color: var(--ink);
    border: 2px solid var(--teal-700);
    max-width: 640px;
    transition: transform 0.15s;
  }
  .next:hover {
    transform: translateY(-2px);
    color: var(--ink);
  }
  .next .eyebrow {
    margin: 0;
  }
  .next-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.35rem;
    font-weight: 720;
    color: var(--teal-800);
  }
  .next-text {
    color: var(--muted);
  }
  .related {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 720px) {
    .related {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .related a {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
    background: #fff;
    border: 1px solid var(--card-line);
    border-radius: 16px;
    text-decoration: none;
    color: var(--ink);
  }
  .related a:hover {
    border-color: var(--teal-600);
  }
  .related strong {
    color: var(--teal-800);
  }
  .related span {
    font-size: 0.93rem;
    color: var(--muted);
  }
</style>
